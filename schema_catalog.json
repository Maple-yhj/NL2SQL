  {
    "table": "refunds",
    "comment": "退款订单信息表，记录每笔退款的交易",
    "columns": [
      {
        "name": "id",
        "type": "integer",
        "nullable": false,
        "default": "nextval('refunds_id_seq'::regclass)",
        "comment": "退款记录id"
      },
      {
        "name": "tenant_id",
        "type": "character varying",
        "nullable": false,
        "default": "'demo'::character varying",
        "comment": "租户ID，用于多租户隔离"
      },
      {
        "name": "order_id",
        "type": "integer",
        "nullable": false,
        "default": null,
        "comment": "退款订单id，外键"
      },
      {
        "name": "user_id",
        "type": "integer",
        "nullable": false,
        "default": null,
        "comment": "退款用户id，外键"
      },
      {
        "name": "amount",
        "type": "numeric",
        "nullable": false,
        "default": null,
        "comment": "退款金额"
      },
      {
        "name": "reason",
        "type": "character varying",
        "nullable": true,
        "default": null,
        "comment": "退款原因"
      },
      {
        "name": "status",
        "type": "character varying",
        "nullable": false,
        "default": "'approved'::character varying",
        "comment": "退款状态：pending,approved,rejected"
      },
      {
        "name": "created_at",
        "type": "timestamp with time zone",
        "nullable": false,
        "default": "now()",
        "comment": "退款记录创建时间"
      }
    ]
  }
]