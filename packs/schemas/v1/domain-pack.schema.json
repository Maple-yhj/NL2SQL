{
  "$defs": {
    "CanonicalEntity": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fields": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/CanonicalField"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": "Fields",
          "type": "object"
        },
        "grain": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        }
      },
      "required": [
        "grain"
      ],
      "title": "CanonicalEntity",
      "type": "object"
    },
    "CanonicalField": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        },
        "timeSemantics": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timesemantics"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "json"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "type"
      ],
      "title": "CanonicalField",
      "type": "object"
    },
    "CanonicalMetric": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "average",
            "min",
            "max"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "combine": {
          "default": "identity",
          "enum": [
            "identity",
            "add"
          ],
          "title": "Combine",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "eventTime": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eventtime"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "aggregation",
        "inputs"
      ],
      "title": "CanonicalMetric",
      "type": "object"
    },
    "CanonicalRelationship": {
      "additionalProperties": false,
      "properties": {
        "cardinality": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "fromEntity": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$",
          "title": "Fromentity",
          "type": "string"
        },
        "fromFields": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fromfields",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "toEntity": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$",
          "title": "Toentity",
          "type": "string"
        },
        "toFields": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Tofields",
          "type": "array"
        }
      },
      "required": [
        "name",
        "fromEntity",
        "toEntity",
        "cardinality",
        "fromFields",
        "toFields"
      ],
      "title": "CanonicalRelationship",
      "type": "object"
    },
    "DomainEvalCalculation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:[A-Z][A-Za-z0-9]*(?:\\.[a-z][a-z0-9_]*)?|[a-z][a-z0-9_]*)$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "operation": {
          "enum": [
            "sum",
            "average",
            "count",
            "count_distinct",
            "add",
            "subtract",
            "multiply",
            "growth",
            "lag",
            "date_difference"
          ],
          "title": "Operation",
          "type": "string"
        },
        "partitionBy": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Partitionby",
          "type": "array"
        }
      },
      "required": [
        "id",
        "operation",
        "inputs"
      ],
      "title": "DomainEvalCalculation",
      "type": "object"
    },
    "DomainEvalCase": {
      "additionalProperties": false,
      "properties": {
        "analysisType": {
          "default": "metric",
          "enum": [
            "metric",
            "trend",
            "ranking",
            "detail",
            "comparison",
            "cross_tab",
            "distribution",
            "derived",
            "follow_up",
            "tenant_scoped"
          ],
          "title": "Analysistype",
          "type": "string"
        },
        "calculations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainEvalCalculation"
          },
          "title": "Calculations",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/DomainEvalContext"
        },
        "expectedDimensions": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Expecteddimensions",
          "type": "array"
        },
        "expectedEntities": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$",
            "type": "string"
          },
          "title": "Expectedentities",
          "type": "array"
        },
        "expectedFields": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Expectedfields",
          "type": "array"
        },
        "expectedGrain": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Expectedgrain",
          "type": "array"
        },
        "expectedMetrics": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Expectedmetrics",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainEvalPredicate"
          },
          "title": "Filters",
          "type": "array"
        },
        "having": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainEvalPredicate"
          },
          "title": "Having",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "ordering": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainEvalOrdering"
          },
          "title": "Ordering",
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainEvalTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "DomainEvalCase",
      "type": "object"
    },
    "DomainEvalContext": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "standalone",
          "enum": [
            "standalone",
            "follow_up"
          ],
          "title": "Mode",
          "type": "string"
        },
        "preserve": {
          "default": [],
          "items": {
            "enum": [
              "metrics",
              "filters",
              "time_range",
              "tenant_scope",
              "grain"
            ],
            "type": "string"
          },
          "title": "Preserve",
          "type": "array"
        },
        "priorQuestion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priorquestion"
        },
        "tenantScope": {
          "default": "all",
          "enum": [
            "all",
            "seller"
          ],
          "title": "Tenantscope",
          "type": "string"
        }
      },
      "title": "DomainEvalContext",
      "type": "object"
    },
    "DomainEvalOrdering": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:[A-Z][A-Za-z0-9]*(?:\\.[a-z][a-z0-9_]*)?|[a-z][a-z0-9_]*)$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "direction"
      ],
      "title": "DomainEvalOrdering",
      "type": "object"
    },
    "DomainEvalPredicate": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "is_null",
            "is_not_null",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:[A-Z][A-Za-z0-9]*(?:\\.[a-z][a-z0-9_]*)?|[a-z][a-z0-9_]*)$",
          "title": "Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "ref",
        "operator"
      ],
      "title": "DomainEvalPredicate",
      "type": "object"
    },
    "DomainEvalTime": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "field": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        },
        "grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "start": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "field"
      ],
      "title": "DomainEvalTime",
      "type": "object"
    },
    "DomainPackSpec": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$": {
              "$ref": "#/$defs/CanonicalEntity"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$"
          },
          "title": "Entities",
          "type": "object"
        },
        "evals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainEvalCase"
          },
          "title": "Evals",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/CanonicalMetric"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$"
          },
          "title": "Metrics",
          "type": "object"
        },
        "policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DomainPolicy"
          },
          "title": "Policies",
          "type": "array"
        },
        "relationships": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CanonicalRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "vocabulary": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VocabularyEntry"
          },
          "title": "Vocabulary",
          "type": "array"
        }
      },
      "title": "DomainPackSpec",
      "type": "object"
    },
    "DomainPolicy": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "DomainPolicy",
      "type": "object"
    },
    "PackMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackMetadata",
      "type": "object"
    },
    "VocabularyEntry": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "default": "zh-CN",
          "minLength": 1,
          "title": "Locale",
          "type": "string"
        },
        "refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.(?:[A-Z][A-Za-z0-9]*(?:\\.[a-z][a-z0-9_]*)?|[a-z][a-z0-9_]*)$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "refs"
      ],
      "title": "VocabularyEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "dataagent.io/domain/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "DomainPack",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/PackMetadata"
    },
    "spec": {
      "$ref": "#/$defs/DomainPackSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "DomainPack",
  "type": "object"
}
