{
  "$defs": {
    "AdminBypassPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedRoles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowedroles",
          "type": "array"
        },
        "principalClaim": {
          "const": "roles",
          "title": "Principalclaim",
          "type": "string"
        }
      },
      "required": [
        "principalClaim",
        "allowedRoles"
      ],
      "title": "AdminBypassPolicy",
      "type": "object"
    },
    "EnterpriseBindingSpec": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$": {
              "$ref": "#/$defs/PhysicalEntityBinding"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$"
          },
          "title": "Bindings",
          "type": "object"
        },
        "domains": {
          "items": {
            "$ref": "#/$defs/PackReference"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "policies": {
          "discriminator": {
            "mapping": {
              "single_tenant": "#/$defs/SingleTenantPolicies",
              "tenant_scoped": "#/$defs/TenantScopedPolicies"
            },
            "propertyName": "accessMode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SingleTenantPolicies"
            },
            {
              "$ref": "#/$defs/TenantScopedPolicies"
            }
          ],
          "title": "Policies"
        },
        "relationships": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/PhysicalRelationshipBinding"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$"
          },
          "title": "Relationships",
          "type": "object"
        },
        "sources": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z_][a-z0-9_]*$": {
              "$ref": "#/$defs/EnterpriseSource"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "title": "Sources",
          "type": "object"
        }
      },
      "required": [
        "domains",
        "sources",
        "policies"
      ],
      "title": "EnterpriseBindingSpec",
      "type": "object"
    },
    "EnterpriseSource": {
      "additionalProperties": false,
      "properties": {
        "connectionRef": {
          "pattern": "^secret://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)+$",
          "title": "Connectionref",
          "type": "string"
        },
        "connector": {
          "const": "postgres",
          "title": "Connector",
          "type": "string"
        },
        "readOnly": {
          "const": true,
          "title": "Readonly",
          "type": "boolean"
        }
      },
      "required": [
        "connector",
        "connectionRef",
        "readOnly"
      ],
      "title": "EnterpriseSource",
      "type": "object"
    },
    "PackMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackMetadata",
      "type": "object"
    },
    "PackReference": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "PackReference",
      "type": "object"
    },
    "PhysicalEntityBinding": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/PhysicalFieldBinding"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": "Fields",
          "type": "object"
        },
        "grain": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        },
        "relation": {
          "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
          "title": "Relation",
          "type": "string"
        },
        "source": {
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "relation",
        "grain"
      ],
      "title": "PhysicalEntityBinding",
      "type": "object"
    },
    "PhysicalFieldBinding": {
      "additionalProperties": false,
      "properties": {
        "cast": {
          "anyOf": [
            {
              "enum": [
                "string",
                "integer",
                "decimal",
                "boolean",
                "date",
                "datetime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cast"
        },
        "coalesceValue": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coalescevalue"
        },
        "column": {
          "anyOf": [
            {
              "pattern": "^[a-z_][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "enumMapping": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Enummapping",
          "type": "object"
        },
        "nullPolicy": {
          "default": "preserve",
          "enum": [
            "preserve",
            "reject",
            "coalesce"
          ],
          "title": "Nullpolicy",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "PhysicalFieldBinding",
      "type": "object"
    },
    "PhysicalRelationshipBinding": {
      "additionalProperties": false,
      "description": "Explicit physical key columns for one canonical relationship.",
      "properties": {
        "fromColumns": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fromcolumns",
          "type": "array"
        },
        "fromEntity": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$",
          "title": "Fromentity",
          "type": "string"
        },
        "toColumns": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Tocolumns",
          "type": "array"
        },
        "toEntity": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$",
          "title": "Toentity",
          "type": "string"
        }
      },
      "required": [
        "fromEntity",
        "toEntity",
        "fromColumns",
        "toColumns"
      ],
      "title": "PhysicalRelationshipBinding",
      "type": "object"
    },
    "SingleTenantPolicies": {
      "additionalProperties": false,
      "properties": {
        "accessMode": {
          "const": "single_tenant",
          "title": "Accessmode",
          "type": "string"
        },
        "maxRows": {
          "default": 1000,
          "minimum": 1,
          "title": "Maxrows",
          "type": "integer"
        },
        "queryTimeoutSeconds": {
          "default": 10,
          "minimum": 1,
          "title": "Querytimeoutseconds",
          "type": "integer"
        },
        "relationAllowlist": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Relationallowlist",
          "type": "array"
        }
      },
      "required": [
        "relationAllowlist",
        "accessMode"
      ],
      "title": "SingleTenantPolicies",
      "type": "object"
    },
    "TenantScopePolicy": {
      "additionalProperties": false,
      "properties": {
        "adminBypass": {
          "$ref": "#/$defs/AdminBypassPolicy"
        },
        "canonicalField": {
          "const": "commerce.Seller.seller_id",
          "title": "Canonicalfield",
          "type": "string"
        },
        "mode": {
          "const": "seller_id",
          "title": "Mode",
          "type": "string"
        },
        "ownershipPaths": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$": {
              "items": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Z][A-Za-z0-9]*$"
          },
          "title": "Ownershippaths",
          "type": "object"
        },
        "principalClaim": {
          "const": "tenant_id",
          "title": "Principalclaim",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "canonicalField",
        "principalClaim",
        "adminBypass",
        "ownershipPaths"
      ],
      "title": "TenantScopePolicy",
      "type": "object"
    },
    "TenantScopedPolicies": {
      "additionalProperties": false,
      "properties": {
        "accessMode": {
          "const": "tenant_scoped",
          "title": "Accessmode",
          "type": "string"
        },
        "maxRows": {
          "default": 1000,
          "minimum": 1,
          "title": "Maxrows",
          "type": "integer"
        },
        "queryTimeoutSeconds": {
          "default": 10,
          "minimum": 1,
          "title": "Querytimeoutseconds",
          "type": "integer"
        },
        "relationAllowlist": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Relationallowlist",
          "type": "array"
        },
        "tenantScope": {
          "$ref": "#/$defs/TenantScopePolicy"
        }
      },
      "required": [
        "relationAllowlist",
        "accessMode",
        "tenantScope"
      ],
      "title": "TenantScopedPolicies",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "dataagent.io/enterprise/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "EnterpriseDataBinding",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/PackMetadata"
    },
    "spec": {
      "$ref": "#/$defs/EnterpriseBindingSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EnterpriseDataBinding",
  "type": "object"
}
