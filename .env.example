# Select exactly one provider and an explicit model version.
# Supported providers: openai, qwen, google, anthropic, glm, deepseek,
# and openai-compatible. Aliases gpt, gemini, claude, and zhipu also work.
LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash

# GPT / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gemini / Google
GEMINI_API_KEY=
GEMINI_BASE_URL=

# Qwen / Alibaba Cloud Model Studio (override with a workspace-specific URL).
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# GLM / Zhipu
ZAI_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Any other OpenAI Chat Completions-compatible service.
LLM_API_KEY=
LLM_BASE_URL=

# Authentication store only. User datasets are uploaded or registered later.
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/nl2sql_auth

# Local control-plane metadata, uploaded snapshots, conversations, and run events.
DATA_AGENT_STATE_DIR=var/data-agent
# Optional legacy governed-pack datasource. It is never loaded by default.
# DATA_AGENT_BUNDLE_PATHS_FILE=/opt/data-agent/acme-bundle-paths.json
# DATABASE_URL is only used when explicitly starting that legacy pack runtime.
DATABASE_URL=
# credential_ref "secret://team/warehouse" resolves this variable.
DATA_SOURCE_SECRET_TEAM_WAREHOUSE=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nl2sql-api
JWT_AUDIENCE=nl2sql-client
