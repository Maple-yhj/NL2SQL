LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=

# DeepSeek alternative
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

