LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=

# DeepSeek alternative
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Business/query database used for schema retrieval and SQL execution.
DATABASE_URL=postgresql://user:password@localhost:5432/nl2sql_data

# Memory database used for conversation history and user memories.
MEMORY_DATABASE_URL=postgresql://user:password@localhost:5432/nl2sql_memory

# Optional Data Agent memory. Leave DATA_MEMORY_PROVIDER blank to disable.
DATA_MEMORY_PROVIDER=
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=
GRAPHITI_TELEMETRY_ENABLED=false

# Auth database defaults to MEMORY_DATABASE_URL when blank.
AUTH_DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nl2sql-api
JWT_AUDIENCE=nl2sql-client
