LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=

# DeepSeek alternative
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OList business data, Data Agent memory, and default auth store.
DATABASE_URL=postgresql://user:password@localhost:5432/nl2sql_data

# Optional auth override; defaults to DATABASE_URL when blank.
AUTH_DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nl2sql-api
JWT_AUDIENCE=nl2sql-client
