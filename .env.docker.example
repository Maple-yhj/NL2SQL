# Docker Compose 项目与端口
COMPOSE_PROJECT_NAME=data-agent
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# Compose 内置 PostgreSQL
POSTGRES_DB=data_agent
POSTGRES_USER=data_agent
POSTGRES_PASSWORD=

# 首次启动时创建的管理员；已有同名账号不会被覆盖
BOOTSTRAP_ADMIN_TENANT_ID=demo
BOOTSTRAP_ADMIN_USER_ID=docker-admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLES=admin,user

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nl2sql-api
JWT_AUDIENCE=nl2sql-client

# 模型配置。通用变量适用于所有受支持提供方。
LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=

# 如需注册 PostgreSQL 分析数据源，可继续添加：
# DATA_SOURCE_SECRET_WAREHOUSE_MAIN=postgresql://只读用户:密码@主机:5432/数据库
