{
  "domain_id": "olist",
  "display_name": "OList E-Commerce",
  "version": "1",
  "tables": {
    "olist_order_items_dataset": {
      "aliases": ["订单明细", "商品明细", "order items", "items"],
      "primary_keys": ["order_id", "order_item_id"],
      "role": "fact"
    },
    "olist_orders_dataset": {
      "aliases": ["订单", "orders", "订单主表"],
      "primary_keys": ["order_id"],
      "role": "dimension"
    },
    "olist_customers_dataset": {
      "aliases": ["客户", "customers", "客户地理"],
      "primary_keys": ["customer_id"],
      "role": "dimension"
    },
    "olist_sellers_dataset": {
      "aliases": ["卖家", "sellers", "商家"],
      "primary_keys": ["seller_id"],
      "role": "dimension"
    },
    "olist_products_dataset": {
      "aliases": ["商品", "products", "商品品类"],
      "primary_keys": ["product_id"],
      "role": "dimension"
    },
    "olist_order_payments_dataset": {
      "aliases": ["支付", "payments", "支付方式"],
      "primary_keys": ["order_id", "payment_sequential"],
      "role": "fact"
    },
    "olist_order_reviews_dataset": {
      "aliases": ["评价", "reviews", "评分"],
      "primary_keys": ["review_id"],
      "role": "fact"
    },
    "olist_geolocation_dataset": {
      "aliases": ["地理位置", "geolocation", "经纬度"],
      "primary_keys": ["geolocation_zip_code_prefix"],
      "role": "dimension"
    },
    "product_category_name_translation": {
      "aliases": ["品类翻译", "category translation", "english category"],
      "primary_keys": ["product_category_name"],
      "role": "dimension"
    }
  },
  "joins": [
    {
      "left": "olist_order_items_dataset.order_id",
      "right": "olist_orders_dataset.order_id",
      "description": "订单明细关联订单主表"
    },
    {
      "left": "olist_orders_dataset.customer_id",
      "right": "olist_customers_dataset.customer_id",
      "description": "订单关联客户"
    },
    {
      "left": "olist_order_items_dataset.product_id",
      "right": "olist_products_dataset.product_id",
      "description": "订单明细关联商品"
    },
    {
      "left": "olist_order_items_dataset.seller_id",
      "right": "olist_sellers_dataset.seller_id",
      "description": "订单明细关联卖家"
    },
    {
      "left": "olist_order_items_dataset.order_id",
      "right": "olist_order_payments_dataset.order_id",
      "description": "订单明细关联支付记录"
    },
    {
      "left": "olist_order_items_dataset.order_id",
      "right": "olist_order_reviews_dataset.order_id",
      "description": "订单明细关联评价"
    },
    {
      "left": "olist_products_dataset.product_category_name",
      "right": "product_category_name_translation.product_category_name",
      "description": "葡语商品品类关联英文翻译"
    },
    {
      "left": "olist_customers_dataset.customer_zip_code_prefix",
      "right": "olist_geolocation_dataset.geolocation_zip_code_prefix",
      "description": "客户邮编前缀关联经纬度"
    }
  ],
  "terms": {
    "customer_state": {
      "aliases": ["客户州", "客户省份", "customer state", "customer_state", "SP", "RJ"],
      "columns": ["olist_customers_dataset.customer_state"],
      "required_tables": ["olist_orders_dataset", "olist_customers_dataset"]
    },
    "customer_city": {
      "aliases": ["客户城市", "customer city", "customer_city"],
      "columns": ["olist_customers_dataset.customer_city"],
      "required_tables": ["olist_orders_dataset", "olist_customers_dataset"]
    },
    "customer_zip_prefix": {
      "aliases": ["客户邮编", "邮编前缀", "zip prefix", "customer_zip_code_prefix"],
      "columns": ["olist_customers_dataset.customer_zip_code_prefix"],
      "required_tables": ["olist_customers_dataset"]
    },
    "seller_state": {
      "aliases": ["卖家州", "卖家省份", "seller state", "seller_state"],
      "columns": ["olist_sellers_dataset.seller_state"],
      "required_tables": ["olist_sellers_dataset"]
    },
    "seller_city": {
      "aliases": ["卖家城市", "seller city", "seller_city"],
      "columns": ["olist_sellers_dataset.seller_city"],
      "required_tables": ["olist_sellers_dataset"]
    },
    "seller_id": {
      "aliases": ["seller_id", "我的"],
      "columns": ["olist_order_items_dataset.seller_id"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "product_category_name": {
      "aliases": ["商品品类", "品类", "category", "product category", "product_category_name"],
      "columns": [
        "olist_products_dataset.product_category_name",
        "product_category_name_translation.product_category_name_english"
      ],
      "required_tables": [
        "olist_order_items_dataset",
        "olist_products_dataset",
        "product_category_name_translation"
      ]
    },
    "payment_type": {
      "aliases": ["支付方式", "信用卡", "credit card", "credit_card", "payment type", "payment_type"],
      "columns": ["olist_order_payments_dataset.payment_type"],
      "required_tables": ["olist_order_payments_dataset"]
    },
    "payment_installments": {
      "aliases": ["分期", "分期数", "installments", "payment_installments"],
      "columns": ["olist_order_payments_dataset.payment_installments"],
      "required_tables": ["olist_order_payments_dataset"]
    },
    "payment_sequential": {
      "aliases": ["多次支付", "payment_sequential", "支付序号"],
      "columns": ["olist_order_payments_dataset.payment_sequential"],
      "required_tables": ["olist_order_payments_dataset"]
    },
    "payment_value": {
      "aliases": ["支付金额", "payment value", "payment_value"],
      "columns": ["olist_order_payments_dataset.payment_value"],
      "required_tables": ["olist_order_payments_dataset"]
    },
    "item_price": {
      "aliases": ["价格", "商品价格", "item price", "price"],
      "columns": ["olist_order_items_dataset.price"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "freight_value": {
      "aliases": ["运费", "freight", "freight_value"],
      "columns": ["olist_order_items_dataset.freight_value"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "order_status": {
      "aliases": ["订单状态", "已取消", "canceled", "order_status"],
      "columns": ["olist_orders_dataset.order_status"],
      "required_tables": ["olist_orders_dataset"]
    },
    "review_score": {
      "aliases": ["评分", "评价分", "星", "review score", "rating", "review_score"],
      "columns": ["olist_order_reviews_dataset.review_score"],
      "required_tables": ["olist_order_reviews_dataset"]
    },
    "review_comment": {
      "aliases": ["评论", "评论内容", "差评", "review_comment_message", "review_comment_title"],
      "columns": [
        "olist_order_reviews_dataset.review_comment_title",
        "olist_order_reviews_dataset.review_comment_message"
      ],
      "required_tables": ["olist_order_reviews_dataset"]
    },
    "shipping_limit_date": {
      "aliases": ["发货截止时间", "shipping limit", "shipping_limit_date"],
      "columns": ["olist_order_items_dataset.shipping_limit_date"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "order_purchase_timestamp": {
      "aliases": ["购买时间", "purchase timestamp", "order_purchase_timestamp"],
      "columns": ["olist_orders_dataset.order_purchase_timestamp"],
      "required_tables": ["olist_orders_dataset"]
    },
    "delivery_dates": {
      "aliases": ["送达", "配送", "预计送达", "实际送达", "delivery"],
      "columns": [
        "olist_orders_dataset.order_delivered_customer_date",
        "olist_orders_dataset.order_estimated_delivery_date"
      ],
      "required_tables": ["olist_orders_dataset"]
    },
    "geolocation": {
      "aliases": ["经纬度", "地理位置", "geolocation", "lat", "lng"],
      "columns": [
        "olist_geolocation_dataset.geolocation_zip_code_prefix",
        "olist_geolocation_dataset.geolocation_lat",
        "olist_geolocation_dataset.geolocation_lng"
      ],
      "required_tables": ["olist_geolocation_dataset"]
    }
  },
  "metrics": {
    "gmv": {
      "expression": "SUM(olist_order_items_dataset.price + olist_order_items_dataset.freight_value)",
      "base_table": "olist_order_items_dataset",
      "time_column": "shipping_limit_date",
      "aliases": ["GMV", "销售额", "sales revenue", "revenue", "gross merchandise value"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "orders": {
      "expression": "COUNT(DISTINCT olist_order_items_dataset.order_id)",
      "base_table": "olist_order_items_dataset",
      "time_column": "shipping_limit_date",
      "aliases": ["订单数", "订单量", "order count", "orders"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "avg_item_price": {
      "expression": "AVG(olist_order_items_dataset.price)",
      "base_table": "olist_order_items_dataset",
      "time_column": "shipping_limit_date",
      "aliases": ["平均商品价格", "平均客单商品价格", "average item price"],
      "required_tables": ["olist_order_items_dataset"]
    },
    "avg_review_score": {
      "expression": "AVG(olist_order_reviews_dataset.review_score)",
      "base_table": "olist_order_reviews_dataset",
      "time_column": "review_creation_date",
      "aliases": ["平均评价分", "平均评分", "avg review score", "rating"],
      "required_tables": ["olist_order_reviews_dataset"]
    }
  },
  "calculated_fields": {
    "delivery_days": {
      "expression": "order_delivered_customer_date - order_purchase_timestamp",
      "aliases": ["配送天数", "实际配送天数", "delivery days"],
      "required_tables": ["olist_orders_dataset"]
    },
    "delivery_delay": {
      "expression": "order_delivered_customer_date - order_estimated_delivery_date",
      "aliases": ["配送延迟", "延迟", "late delivery", "delivery delay"],
      "required_tables": ["olist_orders_dataset"]
    },
    "approval_duration": {
      "expression": "order_approved_at - order_purchase_timestamp",
      "aliases": ["审批耗时", "approval duration"],
      "required_tables": ["olist_orders_dataset"]
    },
    "carrier_handoff_duration": {
      "expression": "order_delivered_carrier_date - order_purchase_timestamp",
      "aliases": ["交给承运商", "承运商", "carrier handoff"],
      "required_tables": ["olist_orders_dataset"]
    },
    "product_volume": {
      "expression": "product_length_cm * product_height_cm * product_width_cm",
      "aliases": ["体积", "商品体积", "volume"],
      "required_tables": ["olist_products_dataset"]
    },
    "review_answer_duration": {
      "expression": "review_answer_timestamp - review_creation_date",
      "aliases": ["评价回复时间", "回复时间", "review answer"],
      "required_tables": ["olist_order_reviews_dataset"]
    }
  },
  "query_rules": {
    "seller_count_by_location": {
      "aliases": ["卖家数量最多", "卖家数量", "卖家数", "卖家州和城市", "seller count"],
      "required_tables": ["olist_sellers_dataset"],
      "required_columns": [
        "olist_sellers_dataset.seller_state",
        "olist_sellers_dataset.seller_city",
        "olist_sellers_dataset.seller_id"
      ],
      "required_group_by": ["seller_state", "seller_city"],
      "required_order_by": ["seller_count DESC"],
      "required_sql_fragments": ["COUNT(DISTINCT", "seller_id"],
      "forbidden_tables": [
        "olist_orders_dataset",
        "olist_order_items_dataset",
        "olist_order_reviews_dataset"
      ],
      "sql_hints": [
        "Use olist_sellers_dataset for seller count by location.",
        "Group by seller_state and seller_city.",
        "COUNT(DISTINCT olist_sellers_dataset.seller_id)",
        "COUNT(DISTINCT olist_sellers_dataset.seller_id) AS seller_count",
        "Order by seller_count DESC."
      ]
    },
    "customer_count_by_location": {
      "aliases": ["客户最多", "客户数量", "客户数", "客户州和城市", "customer count by location", "customers by state and city count"],
      "match_all": ["customer", "state", "city"],
      "required_tables": ["olist_customers_dataset"],
      "required_columns": [
        "olist_customers_dataset.customer_state",
        "olist_customers_dataset.customer_city",
        "olist_customers_dataset.customer_id"
      ],
      "required_group_by": ["customer_state", "customer_city"],
      "required_order_by": ["customer_count DESC"],
      "required_sql_fragments": ["COUNT(DISTINCT", "customer_id"],
      "forbidden_tables": [
        "olist_orders_dataset",
        "olist_order_items_dataset",
        "olist_order_reviews_dataset"
      ],
      "sql_hints": [
        "Use olist_customers_dataset as the base table for customer count by location.",
        "Select customer_state and customer_city, not string constants.",
        "Group by customer_state and customer_city.",
        "COUNT(DISTINCT olist_customers_dataset.customer_id) AS customer_count.",
        "Order by customer_count DESC."
      ]
    },
    "monthly_gmv_trend": {
      "aliases": ["GMV 趋势", "monthly GMV", "monthly GMV trend"],
      "match_all": ["gmv", "month"],
      "match_none": ["增长", "growth"],
      "required_tables": ["olist_order_items_dataset"],
      "required_columns": [
        "olist_order_items_dataset.shipping_limit_date",
        "olist_order_items_dataset.order_id",
        "olist_order_items_dataset.price",
        "olist_order_items_dataset.freight_value"
      ],
      "required_group_by": ["month"],
      "required_sql_fragments": [
        "date_trunc('month'",
        "shipping_limit_date",
        "AS month"
      ],
      "forbidden_sql_fragments": ["TO_CHAR(", "EXTRACT(MONTH", "AS paid_month"],
      "sql_hints": [
        "Monthly GMV or order trends must use date_trunc('month', shipping_limit_date) AS month.",
        "Group by month and order by month ASC.",
        "Do not use TO_CHAR or EXTRACT(MONTH) for month buckets."
      ]
    },
    "monthly_gmv_growth": {
      "aliases": ["GMV 增长最快", "monthly GMV fastest growth month"],
      "match_all": ["gmv", "growth"],
      "sql_hints": [
        "For fastest GMV growth month, aggregate monthly GMV with date_trunc('month', shipping_limit_date) AS month first.",
        "Compute month-over-month growth with LAG or an equivalent previous-month expression.",
        "Order by the growth expression DESC and limit to 1."
      ]
    },
    "monthly_customer_state_gmv": {
      "aliases": ["monthly customer state GMV", "GMV by month and customer state"],
      "match_all": ["gmv", "month", "customer_state"],
      "required_tables": [
        "olist_order_items_dataset",
        "olist_orders_dataset",
        "olist_customers_dataset"
      ],
      "required_columns": [
        "olist_order_items_dataset.shipping_limit_date",
        "olist_order_items_dataset.price",
        "olist_order_items_dataset.freight_value",
        "olist_order_items_dataset.order_id",
        "olist_orders_dataset.customer_id",
        "olist_customers_dataset.customer_state"
      ],
      "required_group_by": ["month", "customer_state"],
      "required_sql_fragments": [
        "date_trunc('month'",
        "shipping_limit_date",
        "AS month",
        "SUM("
      ],
      "forbidden_sql_fragments": ["TO_CHAR(", "EXTRACT(MONTH"],
      "sql_hints": [
        "For follow-up customer state analysis after a monthly GMV trend, preserve the month dimension.",
        "Join order items to orders on order_id, then orders to customers on customer_id.",
        "Group by month and customer_state."
      ]
    },
    "monthly_review_score": {
      "aliases": ["月度平均评价分", "平均评价分趋势", "monthly average review score trend"],
      "match_all": ["review score", "month"],
      "required_tables": ["olist_order_reviews_dataset"],
      "required_columns": [
        "olist_order_reviews_dataset.review_creation_date",
        "olist_order_reviews_dataset.review_score"
      ],
      "required_group_by": ["month"],
      "required_sql_fragments": [
        "date_trunc('month'",
        "review_creation_date",
        "AS month",
        "AVG("
      ],
      "forbidden_sql_fragments": ["TO_CHAR(", "EXTRACT(MONTH"],
      "sql_hints": [
        "Monthly review score trends must use date_trunc('month', review_creation_date) AS month.",
        "Group by month and order by month ASC."
      ]
    },
    "payment_amount_by_type": {
      "aliases": ["支付方式订单数和支付金额", "payment type order count and total payment amount"],
      "match_all": ["payment", "type", "amount"],
      "required_tables": ["olist_order_payments_dataset"],
      "required_columns": [
        "olist_order_payments_dataset.order_id",
        "olist_order_payments_dataset.payment_type",
        "olist_order_payments_dataset.payment_value"
      ],
      "required_group_by": ["payment_type"],
      "required_order_by": ["total_payment_amount DESC"],
      "required_sql_fragments": ["COUNT(DISTINCT", "SUM(payment_value)"],
      "forbidden_tables": ["olist_order_items_dataset"],
      "sql_hints": [
        "Use olist_order_payments_dataset directly for payment type aggregation.",
        "Select payment_type, COUNT(DISTINCT order_id) AS order_count, and SUM(payment_value) AS total_payment_amount.",
        "Group by payment_type and order by total_payment_amount DESC.",
        "Do not join olist_order_items_dataset for this payment-only aggregate."
      ]
    },
    "freight_exceeds_price_detail": {
      "aliases": ["运费超过商品价格", "freight value greater than item price detail records", "freight exceeds price"],
      "required_tables": ["olist_order_items_dataset"],
      "required_columns": [
        "olist_order_items_dataset.order_id",
        "olist_order_items_dataset.product_id",
        "olist_order_items_dataset.seller_id",
        "olist_order_items_dataset.price",
        "olist_order_items_dataset.freight_value"
      ],
      "default_columns": [
        "olist_order_items_dataset.order_id",
        "olist_order_items_dataset.product_id",
        "olist_order_items_dataset.seller_id",
        "olist_order_items_dataset.price",
        "olist_order_items_dataset.freight_value"
      ],
      "required_filters": ["freight_value > price"],
      "forbid_select_star": true,
      "sql_hints": [
        "For freight greater than price detail, explicitly select order_id, product_id, seller_id, price, and freight_value.",
        "Do not use SELECT * when the user requested specific detail fields.",
        "Filter with freight_value > price."
      ]
    },
    "credit_card_installments": {
      "aliases": ["信用卡分期", "credit card installments", "credit_card installments"],
      "required_tables": ["olist_order_payments_dataset"],
      "required_columns": [
        "olist_order_payments_dataset.payment_type",
        "olist_order_payments_dataset.payment_installments",
        "olist_order_payments_dataset.payment_value"
      ],
      "required_filters": ["payment_type = 'credit_card'"],
      "required_group_by": ["payment_installments"],
      "required_order_by": ["payment_installments ASC"],
      "required_sql_fragments": ["AVG(payment_value)"],
      "sql_hints": [
        "Filter payment_type = 'credit_card' before grouping by payment_installments.",
        "Use AVG(payment_value) for average payment amount.",
        "Order by payment_installments ASC."
      ]
    },
    "payment_record_detail": {
      "aliases": ["支付记录", "支付明细", "订单支付记录", "payment detail", "payment record"],
      "required_tables": ["olist_order_payments_dataset"],
      "required_columns": [
        "olist_order_payments_dataset.order_id",
        "olist_order_payments_dataset.payment_type",
        "olist_order_payments_dataset.payment_installments",
        "olist_order_payments_dataset.payment_sequential",
        "olist_order_payments_dataset.payment_value"
      ],
      "default_columns": [
        "olist_order_payments_dataset.order_id",
        "olist_order_payments_dataset.payment_type",
        "olist_order_payments_dataset.payment_installments",
        "olist_order_payments_dataset.payment_sequential",
        "olist_order_payments_dataset.payment_value"
      ],
      "required_order_by": ["payment_value DESC"],
      "forbidden_tables": ["olist_order_items_dataset"],
      "sql_hints": [
        "Return payment record level detail columns, not only order_id and amount.",
        "Do not join olist_order_items_dataset for payment record detail ranking.",
        "Do not use DISTINCT because olist_order_payments_dataset rows are already payment records.",
        "Order by payment_value DESC for highest payment records."
      ]
    },
    "product_volume_detail": {
      "aliases": ["体积最大的商品", "商品体积", "product volume", "largest product volume"],
      "required_tables": ["olist_products_dataset"],
      "required_columns": [
        "olist_products_dataset.product_id",
        "olist_products_dataset.product_category_name",
        "olist_products_dataset.product_length_cm",
        "olist_products_dataset.product_width_cm",
        "olist_products_dataset.product_height_cm",
        "olist_products_dataset.product_weight_g"
      ],
      "optional_tables": ["product_category_name_translation"],
      "suppressed_required_tables": ["product_category_name_translation"],
      "forbidden_tables": ["olist_order_items_dataset"],
      "sql_hints": [
        "Compute product volume as product_length_cm * product_width_cm * product_height_cm.",
        "Select product_length_cm * product_width_cm * product_height_cm AS volume.",
        "Exclude products with NULL length, width, or height before ordering.",
        "Do not join olist_order_items_dataset for product volume ranking.",
        "Use olist_products_dataset.product_category_name directly; do not join product_category_name_translation for product volume detail.",
        "Do not use DISTINCT because olist_products_dataset already has one row per product_id.",
        "Order by computed volume DESC with NULLS LAST if the SQL dialect requires explicit null ordering."
      ]
    },
    "carrier_handoff_by_seller_location": {
      "aliases": ["交给承运商", "承运商", "carrier handoff"],
      "required_tables": [
        "olist_orders_dataset",
        "olist_order_items_dataset",
        "olist_sellers_dataset"
      ],
      "required_columns": [
        "olist_orders_dataset.order_purchase_timestamp",
        "olist_orders_dataset.order_delivered_carrier_date",
        "olist_order_items_dataset.order_id",
        "olist_order_items_dataset.seller_id",
        "olist_sellers_dataset.seller_state"
      ],
      "sql_hints": [
        "Join orders to order items on order_id, then join sellers on seller_id for seller_state.",
        "Compute carrier handoff duration as order_delivered_carrier_date - order_purchase_timestamp."
      ]
    }
  },
  "tenant_scope": {
    "mode": "seller_id",
    "tenant_column": "olist_order_items_dataset.seller_id",
